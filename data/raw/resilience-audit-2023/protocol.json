  "construct": {
    "recommendedName": "Disaster Pressure",
    "recommendedIndonesianName": "Tekanan Bencana",
    "definition": "Relative modeled structural disaster pressure on people, assets and regional systems after the official model accounts for vulnerability and disaster-management capacity. This is not comprehensive resilience, governance quality, a forecast or annual disaster incidence.",
    "hazard": "Physical probability/intensity of a damaging event.",
    "exposure": "People and assets situated in hazard zones.",
    "vulnerability": "Susceptibility of exposed people/assets/systems to harm.",
    "realizedImpact": "Observed harm or disruption during a stated event/reporting period.",
    "adaptiveCapacity": "Ability to prepare, respond, adapt and recover. Natural direction higher is better.",
    "choice": "Pressure, not inverted resilience capacity. Retain overall IRBI as the single proposed CORE; keep adaptive capacity and annual outcomes visible as non-additive context.",
    "directionPolicy": "Record natural direction only. No inversion, normalization, weights or scoring in this audit.",
    "boundaries": [
      "General pollution and air quality remain Environment.",
      "Do not add poverty/unemployment as resilience vulnerability inputs.",
      "Do not duplicate facilities/WASH/housing/insurance from Basic Services.",
      "Do not move disease burden from Public Health."
    ]
  },
  "method": {
    "version": "resilience-research-2023-1",
    "admissionGates": [
      "official_source",
      "reference_2023",
      "coverage_27",
      "comparable_definition",
      "comparable_unit",
      "compatible_geography",
      "clear_resilience_construct",
