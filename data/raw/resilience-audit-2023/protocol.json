      "defensible_denominator_if_rate",
      "not_primarily_reporting_intensity",
      "no_embedded_component_double_count"
    ],
    "coreIds": [
      "irbi_overall_2023"
    ],
    "referenceYearPolicy": "A published 2023 composite vintage is admissible only with older component baselines explicitly disclosed. It does not establish fresh 2023 hazard/exposure observation or current operational capacity.",
    "uncertaintyPolicy": "Regional SD, CV and IQR describe the 27 published values, not sampling/model uncertainty. No uncertainty interval, confidence score or precise rank claim is fabricated.",
    "statisticalConvention": {
      "standardDeviation": "population; denominator n",
      "quartiles": "linear interpolation at (n-1)*p, equivalent R7",
      "cv": "100*population SD/mean only for meaningful ratio-scale measures; null for composite indices with arbitrary zero",
      "outliers": "outside Q1-1.5IQR or Q3+1.5IQR, diagnostic only; retain source extremes",
      "correlations": "Pearson on raw observed values; Spearman uses average ranks for ties. Use complete 27-region panels with no ambiguous source interpretation; exclude supporting denominators. Constant-series correlations remain explicitly undefined, not zero. |r| >= 0.85 flags possible redundancy, never automatic removal. No population weighting."
    }
  },
