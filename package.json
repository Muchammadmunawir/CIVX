{
  "name": "civx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "data:build": "node scripts/build-civic-release.mjs && node scripts/build-civic-current.mjs --with-archive",
    "data:build:current": "node scripts/build-civic-current.mjs",
    "data:sensitivity": "node scripts/build-civic-current.mjs --sensitivity",
    "data:replay": "node scripts/build-civic-current.mjs --from-validated-inputs",
    "data:sensitivity:replay": "node scripts/build-civic-current.mjs --sensitivity --from-validated-inputs",
    "data:build:v2": "node scripts/build-civic-v2.mjs",
    "data:sensitivity:v2": "node scripts/build-civic-v2.mjs --sensitivity",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
